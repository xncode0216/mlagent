# MLAgent backend configuration template.
# Copy to `.env` and adjust. All keys are prefixed with MLAGENT_.
# Your real `.env` is gitignored — do NOT commit secrets.

# Core
MLAGENT_APP_NAME=MLAgent API
MLAGENT_WORKSPACE_ROOT=workspaces
MLAGENT_DEV_USER_ID=dev-user
MLAGENT_LOG_LEVEL=INFO

# Authentication. Keep development mode only for trusted local use.
# jwt accepts trusted HS256 bearer tokens. oidc accepts RS256 tokens and retrieves
# rotating public keys from a configured HTTPS JWKS endpoint. Both require exp + sub.
MLAGENT_AUTH_MODE=development
MLAGENT_AUTH_JWT_SECRET=
MLAGENT_AUTH_JWT_ISSUER=
MLAGENT_AUTH_JWT_AUDIENCE=
MLAGENT_AUTH_JWT_LEEWAY_SECONDS=30
MLAGENT_AUTH_OIDC_ISSUER=
MLAGENT_AUTH_OIDC_AUDIENCE=
MLAGENT_AUTH_OIDC_JWKS_URL=
MLAGENT_AUTH_OIDC_JWKS_CACHE_SECONDS=300
MLAGENT_AUTH_OIDC_JWKS_TIMEOUT_SECONDS=5
# Browser Authorization Code + PKCE flow. These URLs must use HTTPS.
# The optional client secret is sent with HTTP Basic auth, never to the browser.
MLAGENT_AUTH_OIDC_AUTHORIZATION_URL=
MLAGENT_AUTH_OIDC_TOKEN_URL=
MLAGENT_AUTH_OIDC_CLIENT_ID=
MLAGENT_AUTH_OIDC_CLIENT_SECRET=
MLAGENT_AUTH_OIDC_REDIRECT_URI=
MLAGENT_AUTH_BROWSER_RETURN_URL=
MLAGENT_AUTH_OIDC_TOKEN_TIMEOUT_SECONDS=5
MLAGENT_AUTH_LOGIN_TRANSACTION_TTL_SECONDS=600
MLAGENT_AUTH_SESSION_TTL_SECONDS=28800

# CORS: comma-separated list of origins allowed to call the API.
MLAGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# LLM (P0-1). provider: openai | deepseek | vllm | anthropic. Leave empty to disable.
# Keys are read from env only — never commit them. Self-hosted vLLM may omit the key.
MLAGENT_LLM_PROVIDER=
MLAGENT_LLM_MODEL=
MLAGENT_LLM_API_KEY=
MLAGENT_LLM_BASE_URL=
MLAGENT_LLM_TEMPERATURE=0.2
MLAGENT_LLM_MAX_TOKENS=1024
MLAGENT_LLM_TIMEOUT_SECONDS=60

# Datastores (currently optional — see docs/production-readiness-review.md P1-3).
# Override with managed credentials in real deployments; never ship defaults.
MLAGENT_DATABASE_URL=postgresql+psycopg://mlagent:mlagent@localhost:5432/mlagent
MLAGENT_REDIS_URL=redis://localhost:6379/0

# Kernel execution
MLAGENT_KERNEL_BACKEND=local
MLAGENT_KERNEL_IMAGE=mlagent-kernel:dev
MLAGENT_DOCKER_EXECUTABLE=docker
MLAGENT_KERNEL_MEMORY_LIMIT=2g
MLAGENT_KERNEL_CPU_LIMIT=2
MLAGENT_KERNEL_PIDS_LIMIT=512
MLAGENT_KERNEL_WORKSPACE_MOUNT_MODE=rw
MLAGENT_GPU_ACQUIRE_TIMEOUT_SECONDS=30
